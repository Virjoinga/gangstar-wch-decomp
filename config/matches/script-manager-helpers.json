{
    "toolchain": "toolchain/android-ndk-1.6_r1/build/prebuilt/windows/arm-eabi-4.2.1",
    "compiler_flags": [
        "-O2",
        "-fpic",
        "-fno-toplevel-reorder",
        "-fno-strict-aliasing",
        "-fno-rtti",
        "-fno-exceptions",
