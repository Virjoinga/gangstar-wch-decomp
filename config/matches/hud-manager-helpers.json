{
    "toolchain": "toolchain/android-ndk-1.6_r1/build/prebuilt/windows/arm-eabi-4.2.1",
    "compiler_flags": [
        "-O2",
        "-fpic",
        "-fno-toplevel-reorder",
        "-fno-strict-aliasing",
        "-fno-rtti",
        "-fno-exceptions",
        "-mthumb",
        "-mthumb-interwork",
        "-march=armv5te",
        "-mtune=xscale",
        "-mfloat-abi=softfp",
        "-ffunction-sections",
        "-fdata-sections",
        "-finline-limit=70"
    ],
    "assembler_flags": [
        "-march=armv5te",
        "-mfloat-abi=softfp",
        "-mfpu=vfp",
        "-meabi=4"
    ],
    "source": "src/game/hud/CHudManager.cpp",
    "linker_script": "config/linker/CHudManagerHelpers.ld",
    "functions": [
        "_ZN11CHudManager4initEv",
        "_ZN11CHudManager4lockEv",
        "_ZN11CHudManager6unlockEv",
        "_ZNK11CHudManager8isLockedEv"
    ],
    "sections": [
        ".helper_0",
        ".helper_1",
        ".helper_2",
        ".helper_3"
    ]
}
