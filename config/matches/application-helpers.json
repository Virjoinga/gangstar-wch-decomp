        "-march=armv5te",
        "-mfloat-abi=softfp",
        "-mfpu=vfp",
        "-meabi=4"
    ],
    "source": "src/game/app/Application.cpp",
    "linker_script": "config/linker/ApplicationHelpers.ld",
    "functions": [
        "_ZNK11Application19GetScreenDimensionsERiS0_"
    ],
    "sections": [
        ".screen_dimensions"
    ]
